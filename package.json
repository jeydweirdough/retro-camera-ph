{
  "name": "camera-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "make-admin": "node --env-file=.env.local --experimental-strip-types scripts/make-admin.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "seed:cameras": "node --env-file=.env.local --experimental-strip-types scripts/seed-store-cameras.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@neon/auth": "^0.8.2",
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "next-sanity": "^13.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.21.0",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
